# LLM API Key (Required)
# Place your API key here (supports LLM_API_KEY, VITE_LLM_API_KEY, or GEMINI_API_KEY)
LLM_API_KEY=your_api_key_here

# LLM Model Selection
# Specify the model name to use for chat (e.g., gemini-2.5-flash, gpt-4o, etc.)
LLM_MODEL_NAME=gemini-2.5-flash

# Text-to-Speech (TTS) Model Selection
# Specify the TTS model name (e.g., gemini-3.1-flash-tts-preview)
LLM_TTS_MODEL_NAME=gemini-3.1-flash-tts-preview

# Bot Customization (Optional)
VITE_BOT_NAME="AI Co-Worker"
VITE_BOT_TITLE="AI Co-Worker"
VITE_BOT_SUBTITLE="Explore. Ask. Discover."
